# ==============================================================================
# SECTION A: CONVEX ENVIRONMENT VARIABLES (Backend)
# These MUST be configured in your CONVEX DASHBOARD (https://dashboard.convex.dev)
# ==============================================================================

# Better Auth & Site Config
BETTER_AUTH_SECRET=your_better_auth_secret_here
SITE_URL=http://localhost:3000

# OAuth Providers (Google & Facebook)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ImageKit Private Key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key

# Razorpay (Backend Credentials)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Resend Email (Used for Better Auth OTPs / Password Resets in auth.ts)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=support@upharvilla.in

# Brevo Transactional Email Queue (Used for Store Emails)
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=hello@upharvilla.in
BREVO_SENDER_NAME=UpharVilla

# (Optional) Brevo Template IDs
# Leave blank to automatically fall back to code-generated HTML layouts
BREVO_TEMPLATE_ORDER_CONFIRMATION=
BREVO_TEMPLATE_ORDER_STATUS_UPDATE=
BREVO_TEMPLATE_ADMIN_ORDER_ALERT=
BREVO_TEMPLATE_ADMIN_ENQUIRY_ALERT=
BREVO_TEMPLATE_ENQUIRY_AUTOREPLY=
BREVO_TEMPLATE_ORDER_REMINDER=
BREVO_TEMPLATE_RESTOCK_NOTIFICATION=
BREVO_TEMPLATE_CART_FOLLOWUP=
BREVO_TEMPLATE_THANK_YOU=
BREVO_TEMPLATE_REVIEW_REQUEST=

# WhatsApp Business Cloud API (Convex Dashboard)
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# ==============================================================================
# SECTION B: VERCEL ENVIRONMENT VARIABLES (Frontend)
# These MUST be configured in your VERCEL DASHBOARD (https://vercel.com)
# ==============================================================================

# Better Auth Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Convex Database Connections
CONVEX_DEPLOYMENT=your_convex_deployment_name
NEXT_PUBLIC_CONVEX_URL=https://your_deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your_deployment.convex.site
CONVEX_DEPLOY_KEY=your_convex_deploy_key

# ImageKit Public & Private Credentials
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint/

# Razorpay Backend & Frontend Credentials
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
